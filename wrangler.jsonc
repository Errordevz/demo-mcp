{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demo-mcp",
  "main": "platform-entry.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "DEMO_PLATFORM_ORIGIN": "https://demo-platform.pages.dev"
  }
}
