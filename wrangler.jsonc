{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demo-mcp",
  "main": "platform-entry.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "demo-mcp-screenshots"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER_SESSIONS",
        "class_name": "BrowserSession"
      },
      // Stores ChatGPT OAuth grants. Values are token/code hashes; atomic
      // consumption prevents replay across isolates.
      {
        "name": "MCP_AUTH",
        "class_name": "McpAuth"
      },
      // Shared coding workspace persistence (`collab:*` keys).
      {
        "name": "DEMO_ACCOUNTS",
        "class_name": "DemoAccounts"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrowserSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RobloxAuth"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["McpAuth"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["DemoAccounts"]
    },
    {
      "tag": "v5",
      "deleted_classes": ["RobloxAuth"]
    }
  ],
  // Workers AI binding. Enables server-side speech-to-text (video_transcribe)
  // and frame-grounded scene/OCR labels (video_analyze, video_react,
  // inspect_video). Everything else — resolution, verified byte retrieval,
  // frame decoding, artifacts — works without it, and every AI-dependent step
  // degrades to an explicit structured "unavailable" when the binding is absent.
  //
  // `remote: true` states what is already true: Workers AI has no local
  // emulation, so a `wrangler dev` run calls the real, billable service. Wrangler
  // warns about this on every local start; declaring it removes the warning and
  // records the cost decision in review instead of leaving it to a runtime log.
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    // ── Secrets are deliberately NOT declared here ─────────────────────────────
    // Set them in the dashboard (Workers → Settings → Variables and secrets →
    // Encrypt) or with `wrangler secret put <NAME>`, per environment:
    //   TYPESAFE_API_KEY      — TypeSafe/Jev decision API key
    //   LAYA_API_KEY          — optional Laya decision-server credential (only when
    //                           the configured Laya server requires a bearer)
    //   YOUTUBE_API_KEY       — YouTube Data API v3 key for public YouTube operations
    //   TRANSCRIPTION_API_KEY — optional external speech-to-text provider
    // MCP OAuth uses the MCP_AUTH Durable Object and verified Cloudflare Access
    // identity to issue per-user, short-lived grants.
    "DEMO_PLATFORM_ORIGIN": "https://demo-platform.pages.dev",
    // Canonical HTTPS origin is used for OAuth issuer/resource metadata and links.
    // Change it to the deployed custom domain if one is in use; never derive it from Host.
    "MCP_PUBLIC_ORIGIN": "https://demo-mcp.amidevz.workers.dev",
    "MCP_AUTH_ACCESS_TEAM_DOMAIN": "<your-team>.cloudflareaccess.com",
    "MCP_AUTH_ACCESS_AUD": "<your-cloudflare-access-application-aud-tag>",
    "MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "900",
    "MCP_AUTH_RATE_LIMIT_PER_MINUTE": "30",
    "BROWSER_PROVIDER": "cloudflare",
    "BROWSER_KEEPALIVE_MS": "300000",
    // DNS half of the SSRF guard. The static rules (scheme allow-list, private
    // / loopback / link-local / metadata ranges, internal DNS suffixes, blocked
    // ports) are always enforced. This flag only controls what happens when the
    // DNS-over-HTTPS resolver cannot be reached: "false" = fail closed (deny an
    // unverifiable hostname), "true" = allow it with a `dns-unverified` warning.
    // Fail-closed is the default everywhere in the code; this file used to set
    // fail-open, which meant a resolver outage silently disabled the
    // DNS-rebinding half of the guard. Set to "true" only if a deployment
    // prefers availability here, understanding exactly that trade.
    "SSRF_DNS_CHECK": "true",
    "SSRF_DNS_FAIL_OPEN": "false",

    // ── Video pipeline policy ────────────────────────────────────────────────
    // Hard limits. A tool argument can only ever LOWER these, never raise them.
    "VIDEO_MAX_DOWNLOAD_MB": "50",
    "VIDEO_MAX_DURATION_SECONDS": "600",
    "VIDEO_ARTIFACT_TTL_SECONDS": "3600",
    "VIDEO_RATE_LIMIT_PER_MINUTE": "12",

    // ── Jev Decision Engine (TypeSafe) ───────────────────────────────────────
    // Policy only. TYPESAFE_API_KEY must be a *secret*
    // (`wrangler secret put TYPESAFE_API_KEY`) and is intentionally absent here:
    // a committed credential is a leaked one. jev_decide additionally requires
    // the user's short-lived decision:use DEMO OAuth scope before any paid call.
    // With no credential configured the engine is off and every workflow falls
    // back to DEMO's own deterministic rules.
    "TYPESAFE_ENABLED": "true",
    // `jev-latest` is the documented alias for the newest stable release; pin a
    // versioned id (e.g. jev-1.13.0) if you tune the thresholds against it.
    "TYPESAFE_MODEL": "jev-latest",
    // A decision is optional work: it must never hold a request open.
    "TYPESAFE_DECISION_TIMEOUT_MS": "2500",
    // Below `review` the answer is reported but not acted on; below `accept` it is
    // applied with a review flag; at or above `accept` it is applied quietly.
    "TYPESAFE_REVIEW_THRESHOLD": "0.5",
    "TYPESAFE_ACCEPT_THRESHOLD": "0.7",

    // ── Laya decision provider (external System One server) ──────────────────
    // Policy only. Laya is an EXTERNAL typed-decision server that speaks the same
    // Jev-compatible API (POST /v1/systemone); DEMO never hosts, runs or bundles
    // the Laya model. The endpoint itself (LAYA_BASE_URL) is deliberately NOT set
    // here: it is per-deployment infrastructure, set it in the dashboard or your
    // own wrangler overrides. LAYA_API_KEY is optional (some Laya servers are
    // unauthenticated) and must be a *secret* (`wrangler secret put LAYA_API_KEY`) —
    // it is intentionally absent here: a committed credential is a leaked one.
    // The configured endpoint passes DEMO's full SSRF guard (https only, no
    // private/metadata targets, DNS-checked) on every call, and Laya answers are
    // advisory only — they can never authorize tools or bypass DEMO's checks.
    "LAYA_ENABLED": "true",
    // Without LAYA_BASE_URL the provider stays off and nothing here costs anything.
    "LAYA_TIMEOUT_MS": "2500",
    "LAYA_MODEL": "laya-latest",
    // Typed-decision routing: auto (Laya → Jev → deterministic fallback) | laya | jev.
    "DECISION_PROVIDER_MODE": "auto",

    // Optional Workers AI model ids (only used when the AI binding exists).
    // VIDEO_VISION_MODEL is also reused for PDF OCR + image describe/OCR.
    "VIDEO_TRANSCRIPTION_MODEL": "@cf/openai/whisper",
    "VIDEO_VISION_MODEL": "@cf/llava-hf/llava-1.5-7b-hf",

    // ── DEMO 0.9 expanded capabilities (policy only; no secrets) ─────────────
    // Public Git (smart-HTTP): size/time/rate caps. There is deliberately NO
    // credential variable — private repositories are refused, never negotiated.
    "GIT_MAX_PACK_MB": "20",
    "GIT_REQUEST_TIMEOUT_MS": "25000",
    "GIT_RATE_LIMIT_PER_MINUTE": "6",
    "GIT_MAX_DEPTH": "200",
    "GIT_MEMORY_MAX_MB": "48",
    "GIT_TEMP_REPO_TTL_MS": "600000",
    // Shared per-minute budget for the read-only fetch-backed capabilities
    // (Internet Archive, feeds, PDFs, images, web diff/monitor, OpenAPI, research).
    "TOOL_RATE_LIMIT_PER_MINUTE": "12",
    // Web snapshots + monitors reuse the SCREENSHOTS R2 bucket as expiring
    // objects (same TTL/cleanup convention as screenshots and video artifacts).
    "SNAPSHOT_RETENTION_SECONDS": "604800",
    // Website monitor checks run on demand (web_monitor mode: check). The
    // hourly cron sweep stays OFF unless explicitly enabled here — a registered
    // URL must never silently become an unbounded recurring job.
    "WEB_MONITOR_SCHEDULED_CHECKS": "false",
    // Per-call download ceilings (a tool argument may only lower these).
    "PDF_MAX_MB": "25",
    "IMAGE_MAX_MB": "8",
    // ── Reverse engineering (policy only; no secrets, no endpoints) ─────────
    // Static analysis only by default. DEMO parses bytes and reports evidence;
    // it never executes a target and exposes no arbitrary command execution.
    // A tool argument may only LOWER these caps, never raise them.
    "RE_ENABLED": "true",
    "RE_MAX_TARGET_MB": "16",
    "RE_MAX_ANALYSIS_MS": "20000",
    // Dynamic (instrumented) analysis is OFF by default and additionally
    // requires an external analysis service AND an explicit per-request
    // authorization. Turning it on here does not make it run.
    "RE_DYNAMIC_ENABLED": "false",
    "RE_ARTIFACT_TTL_SECONDS": "3600",
    "RE_RATE_LIMIT_PER_MINUTE": "12"
    // The external analysis service (headless Ghidra / binutils / radare2 /
    // Frida / Jadx …) is per-deployment infrastructure and is deliberately NOT
    // declared here — set RE_ANALYZER_URL in the dashboard or your own
    // wrangler overrides, and its credential as an encrypted Worker secret
    // (`wrangler secret put RE_ANALYZER_KEY`). Both are intentionally absent:
    // a committed endpoint or credential is a leaked one. Without them the
    // capability stays static and reports the missing engines instead of
    // faking them.

    // Optional external speech-to-text provider (alternative to Workers AI).
    // Set both as secrets: wrangler secret put TRANSCRIPTION_ENDPOINT
    //                           wrangler secret put TRANSCRIPTION_API_KEY
    // "TRANSCRIPTION_ENDPOINT": "https://<your-stt-provider.example.com>/v1/transcriptions"
  }
}
