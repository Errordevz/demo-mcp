# DEMO MCP — environment template
#
# Copy to .env for local runs (wrangler dev reads .dev.vars; vitest reads .env
# via shell). NEVER commit real secrets. Values below are placeholders only.

# ── Live test suite (tests/live.test.ts + tests/video-live.test.ts) ──────────
# Opt the live tests in. Without this they skip (they consume browser-minutes).
DEMO_MCP_LIVE=1

# Option A — test a DEPLOYED worker (needs no local Cloudflare credentials):
LIVE_WORKER_URL=https://demo-mcp.<subdomain>.workers.dev
# Bearer token for that worker, if DEMO_API_KEY is set there (leave blank if open):
LIVE_API_KEY=

# Option B — boot `wrangler dev` locally (needs Cloudflare credentials so the
# dev runtime can reach Browser Run / R2 / Durable Objects). Leave
# LIVE_WORKER_URL unset to use the local dev worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional overrides for the local dev worker:
# LIVE_BASE_URL=http://127.0.0.1:8799
# LIVE_PORT=8799

# Live test fixtures (optional):
# Public TikTok URL for the TikTok acceptance tests (short links are supported):
# LIVE_TIKTOK_URL=https://www.tiktok.com/@tiktok/video/7106594312292453675
# Stable public MP4 (small, short, no DRM) for the video_ingest round-trip test:
# LIVE_PUBLIC_VIDEO_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4

# ── Worker runtime (optional; bindings live in wrangler.jsonc) ───────────────
# Optional: require `Authorization: Bearer <key>` on /mcp (unset = open
# endpoint; no tool needs a separate key).
# Set it with: wrangler secret put DEMO_API_KEY
# DEMO_API_KEY=

# CORS allowlist for the platform UI (comma-separated):
# DEMO_PLATFORM_ORIGIN=https://demo-platform.pages.dev

# ── Optional providers (everything below is OPTIONAL) ───────────────────────
# DEMO's video pipeline works without any of these:
#   • video_resolve  — URL/short-link resolution + honest access_status
#   • video_fetch    — verified retrieval of the actual MP4/WebM bytes into R2
#   • video_extract_frames / video_get_frame / inspect_video / video_analyze /
#     video_react — real decoded frames (needs the Cloudflare Browser Rendering
#     binding, which is a Cloudflare service, not an external provider)
# Read demo://capabilities/video (or GET /capabilities/video) at runtime for the
# authoritative per-deployment report.

# Speech-to-text — option A: Workers AI (add to wrangler.jsonc: "ai": {"binding": "AI"})
# Model id override (default @cf/openai/whisper):
# VIDEO_TRANSCRIPTION_MODEL=@cf/openai/whisper

# Speech-to-text — option B: any HTTPS provider DEMO can POST audio to.
# Both values are secrets: wrangler secret put TRANSCRIPTION_ENDPOINT
#                          wrangler secret put TRANSCRIPTION_API_KEY
# TRANSCRIPTION_ENDPOINT=https://<your-stt-provider.example.com>/v1/transcriptions
# TRANSCRIPTION_API_KEY=

# Frame-grounded vision labels (scene changes, on-screen text) — Workers AI only.
# Without it the raw frames are still returned for the connected model to read.
# VIDEO_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# There is NO external ffmpeg/decoder provider and no hidden hard requirement:
# frame decoding always happens in Cloudflare Browser Rendering.

# ── Video policy limits (wrangler.jsonc ships these defaults) ───────────────
# A tool argument may only lower a limit, never raise it.
# VIDEO_MAX_DOWNLOAD_MB=50
# VIDEO_MAX_DURATION_SECONDS=600
# VIDEO_ARTIFACT_TTL_SECONDS=3600
# VIDEO_RATE_LIMIT_PER_MINUTE=12

# Optional separate R2 bucket for video/audio artifacts (defaults to SCREENSHOTS):
# declared in wrangler.jsonc as { "binding": "VIDEO_ARTIFACTS", "bucket_name": "…" }

# ── Roblox OAuth 2.0 (account linking) ──────────────────────────────────────
# Full browser-only setup guide (no PC needed): docs/ROBLOX.md
#
# Register the app at https://create.roblox.com/dashboard/credentials
# (Creator Dashboard → OAuth 2.0 Apps → Create App). Private mode is enough for a
# personal deployment: it allows up to 10 unique users.
#
# SECRETS — set these in the Cloudflare dashboard (Workers → Settings → Variables
# and secrets → Encrypt → Add). Never commit them, never put them in vars:
#   ROBLOX_CLIENT_ID       from the Roblox app
#   ROBLOX_CLIENT_SECRET   from the Roblox app (shown once)
#   ROBLOX_TOKEN_KEY       32 random bytes, base64 (`openssl rand -base64 32`)
#                          — encrypts tokens at rest; without it sessions stay in
#                          isolate memory and nothing is persisted in the clear
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_TOKEN_KEY=

# The exact Redirect URL to register on the Roblox app. Leave unset to use
# <worker-origin>/oauth/roblox/callback; /oauth/roblox/status always reports the
# value this deployment actually sends.
# ROBLOX_REDIRECT_URI=https://demo-mcp.<subdomain>.workers.dev/oauth/roblox/callback
# Reject requests arriving on any other hostname (anti Host-header poisoning):
# ROBLOX_ALLOWED_HOSTS=demo-mcp.<subdomain>.workers.dev

# Minimum scopes. `openid` is required (it is what proves which account is
# connected); `profile` adds display name/username/headshot. Add
# `user.inventory-item:read` only if you want DEMO to read your inventory, and
# `user.advanced:read` / `user.social:read` for the Open Cloud profile.
# Roblox requires re-consent whenever scopes change.
ROBLOX_OAUTH_SCOPES=openid profile

# Policy knobs (defaults shown; ranges enforced in src/roblox/config.ts):
# OAUTH_STATE_TTL_SECONDS=600            # 60-900: start -> callback window
# ROBLOX_SESSION_TTL_SECONDS=1209600     # 14 days; refresh tokens last 90
# ROBLOX_RATE_LIMIT_PER_MINUTE=20        # per client, per OAuth route
# ROBLOX_OPEN_CLOUD_RATE_PER_MINUTE=10   # self-imposed, keeps us under Roblox's limit
# ROBLOX_ACCOUNT_KEY=default             # which account slot this deployment uses

# DEMO never asks for, stores or accepts a Roblox password or .ROBLOSECURITY
# cookie, and never returns a token to a browser, an MCP client, or a log.
