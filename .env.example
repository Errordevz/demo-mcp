# DEMO MCP — environment template
#
# Copy to .env for local runs (wrangler dev reads .dev.vars; vitest reads .env
# via shell). NEVER commit real secrets. Values below are placeholders only.

# ── Live test suite (tests/live.test.ts + tests/video-live.test.ts) ──────────
# Opt the live tests in. Without this they skip (they consume browser-minutes).
DEMO_MCP_LIVE=1

# Option A — test a DEPLOYED worker (needs no local Cloudflare credentials):
LIVE_WORKER_URL=https://demo-mcp.<subdomain>.workers.dev
# Public live tests need no bearer. Protected-tool live OAuth is a separate manual test.

# Option B — boot `wrangler dev` locally (needs Cloudflare credentials so the
# dev runtime can reach Browser Run / R2 / Durable Objects). Leave
# LIVE_WORKER_URL unset to use the local dev worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional overrides for the local dev worker:
# LIVE_BASE_URL=http://127.0.0.1:8799
# LIVE_PORT=8799

# Live test fixtures (optional):
# Public TikTok URL for the TikTok acceptance tests (short links are supported):
# LIVE_TIKTOK_URL=https://www.tiktok.com/@tiktok/video/7106594312292453675
# Stable public MP4 (small, short, no DRM) for the direct-MP4 live tests. The
# deploy workflow publishes tests/fixtures/live-public-video.mp4 to R2 and sets
# this to its public r2.dev URL; locally the default is a 10 s Big Buck Bunny clip.
# LIVE_PUBLIC_VIDEO_URL=https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4

# ── MCP OAuth 2.1 (bindings live in wrangler.jsonc) ──────────────────────────
# Required non-secret OAuth configuration; MCP_PUBLIC_ORIGIN must be the exact
# canonical HTTPS deployment origin (http://localhost:8787 is allowed locally).
MCP_PUBLIC_ORIGIN=https://demo-mcp.<subdomain>.workers.dev
MCP_AUTH_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
MCP_AUTH_ACCESS_AUD=<cloudflare-access-application-audience-tag>
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
MCP_AUTH_RATE_LIMIT_PER_MINUTE=30
# Create a human Cloudflare Access application for /oauth/authorize only.
# Leave /mcp, metadata, /oauth/token, and /oauth/revoke reachable without an
# interactive Access login; protect no public tool routes.

# CORS allowlist for the platform UI (comma-separated):
# DEMO_PLATFORM_ORIGIN=https://demo-platform.pages.dev

# ── Optional providers (everything below is OPTIONAL) ───────────────────────
# DEMO's video pipeline works without any of these:
#   • video_resolve  — URL/short-link resolution + honest access_status
#   • video_fetch    — verified retrieval of the actual MP4/WebM bytes into R2
#   • video_extract_frames / video_get_frame / inspect_video / video_analyze /
#     video_react — real decoded frames (needs the Cloudflare Browser Rendering
#     binding, which is a Cloudflare service, not an external provider)
# Read demo://capabilities/video (or GET /capabilities/video) at runtime for the
# authoritative per-deployment report.

# Speech-to-text — option A: Workers AI (add to wrangler.jsonc: "ai": {"binding": "AI"})
# Model id override (default @cf/openai/whisper):
# VIDEO_TRANSCRIPTION_MODEL=@cf/openai/whisper

# Speech-to-text — option B: any HTTPS provider DEMO can POST audio to.
# Both values are secrets: wrangler secret put TRANSCRIPTION_ENDPOINT
#                          wrangler secret put TRANSCRIPTION_API_KEY
# TRANSCRIPTION_ENDPOINT=https://<your-stt-provider.example.com>/v1/transcriptions
# TRANSCRIPTION_API_KEY=

# Frame-grounded vision labels (scene changes, on-screen text) — Workers AI only.
# Without it the raw frames are still returned for the connected model to read.
# VIDEO_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# There is NO external ffmpeg/decoder provider and no hidden hard requirement:
# frame decoding always happens in Cloudflare Browser Rendering.

# ── Video policy limits (wrangler.jsonc ships these defaults) ───────────────
# A tool argument may only lower a limit, never raise it.
# VIDEO_MAX_DOWNLOAD_MB=50
# VIDEO_MAX_DURATION_SECONDS=600
# VIDEO_ARTIFACT_TTL_SECONDS=3600
# VIDEO_RATE_LIMIT_PER_MINUTE=12

# Optional separate R2 bucket for video/audio artifacts (defaults to SCREENSHOTS):
# declared in wrangler.jsonc as { "binding": "VIDEO_ARTIFACTS", "bucket_name": "…" }

# ── Jev Decision Engine (TypeSafe) — optional ────────────────────────────────
# TypeSafe is the provider; Jev is its System One decision model: it turns text
# and application state into typed answers (choice / score / noul) with
# probabilities instead of generating prose. DEMO uses it as an *advisory*
# decision capability — never a chat model, never an authorizer. The `jev_decide`
# tool additionally requires the caller's DEMO OAuth `decision:use` scope; the
# TypeSafe key remains a separate server-side secret.
# Docs: https://docs.typesafe.ai/api.md  Keys: https://console.typesafe.ai/keys

# SECRET ONLY — set it in the Cloudflare dashboard (Workers → Settings →
# Variables and secrets → Encrypt) or with `wrangler secret put TYPESAFE_API_KEY`.
# Never in vars, never in a URL, never logged. Keys are read at call time only.
# TYPESAFE_API_KEY=

# Non-secret policy. With no credential the engine is off and every workflow uses
# DEMO's own deterministic rules, so all of these are optional.
TYPESAFE_ENABLED=true
TYPESAFE_MODEL=jev-latest
TYPESAFE_DECISION_TIMEOUT_MS=2500
# Confidence floor: below `review` a decision is recorded but not acted on; between
# the two it is applied with requiresReview=true; at or above `accept` it is applied.
# Confidence is the shape of the probability distribution, NOT a guarantee of
# correctness — validate both numbers against your own traffic before raising them.
TYPESAFE_REVIEW_THRESHOLD=0.5
TYPESAFE_ACCEPT_THRESHOLD=0.7

# ── Laya decision provider (external) — optional ──────────────────────────────
# Laya is a second typed-decision provider alongside TypeSafe/Jev: an external
# server speaking the same Jev-compatible API (POST /v1/systemone), returning
# typed answers (choice / score / noul) with probabilities. It is NOT a chat model.
# DEMO never hosts, runs or bundles the Laya model — it only talks HTTP to the
# server you point it at. Full guide: docs/LAYA.md.
#
# Minimal setup (this is all a real deployment needs):
#   LAYA_ENABLED=true
#   LAYA_BASE_URL=https://your-laya-server.example
#   LAYA_API_KEY=your-secret          ← only when your Laya server requires a bearer
#
# NOT a secret — plain variable. Public https origin (+ optional path prefix); the
# decision path /v1/systemone is appended automatically. The value goes through
# DEMO's full SSRF guard on every call: https only, no loopback/private/metadata
# targets, no infrastructure ports, no embedded credentials, DNS-checked.
# LAYA_BASE_URL=
#
# SECRET ONLY (optional) — set it in the Cloudflare dashboard (Workers → Settings →
# Variables and secrets → Encrypt) or with `wrangler secret put LAYA_API_KEY`.
# Sent as exactly one `Authorization: Bearer …` header; never in a URL, a var, a
# log line, an error, or any status surface. With no secret configured, DEMO calls
# the Laya server unauthenticated.
# LAYA_API_KEY=
#
# Non-secret policy (defaults shown; wrangler.jsonc ships the same values):
# LAYA_ENABLED=true                    # master switch; false = zero Laya traffic
# LAYA_TIMEOUT_MS=2500                 # per-request budget (250–15000)
# LAYA_MODEL=laya-latest               # model id sent in `model`
#
# Which provider answers a typed decision: auto (Laya → Jev → deterministic
# fallback) | laya (Laya only, honest error when unavailable) | jev (Jev only,
# the unchanged pre-Laya path). jev_decide can override per call via `provider`.
# DECISION_PROVIDER_MODE=auto

# ── DEMO 0.9 expanded capabilities (policy only; NO new secrets) ─────────────
# Everything below is non-secret policy. There is deliberately NO variable for
# Git credentials of any kind: DEMO inspects PUBLIC repositories over the Git
# smart-HTTP protocol (GitHub, GitLab, Codeberg, Gitea, any compatible host)
# with no API key, and private repositories are a hard, honest refusal.

# Public Git (smart-HTTP) limits — a tool argument may only lower these:
# GIT_MAX_PACK_MB=20                 # per-operation download ceiling
# GIT_REQUEST_TIMEOUT_MS=25000       # network budget per Git request
# GIT_RATE_LIMIT_PER_MINUTE=6        # Git ops per minute per repository
# GIT_MAX_DEPTH=200                  # deepest history a caller may request
# GIT_MEMORY_MAX_MB=48               # temporary in-memory clone quota
# GIT_TEMP_REPO_TTL_MS=600000        # temp clone lifetime (then wiped)

# Shared budget for the read-only public capabilities (Internet Archive,
# feeds, PDFs, images, web diff/monitor, OpenAPI, research):
# TOOL_RATE_LIMIT_PER_MINUTE=12

# Web snapshots + website monitors reuse the SCREENSHOTS R2 bucket as expiring
# objects (same TTL/cleanup convention as screenshots/video artifacts):
# SNAPSHOT_RETENTION_SECONDS=604800
# Monitor checks run on demand (web_monitor mode: check). The existing hourly
# cron sweep stays OFF unless enabled — a registered URL must never silently
# become an unbounded recurring job:
# WEB_MONITOR_SCHEDULED_CHECKS=false

# Per-call download ceilings for PDFs and images (a tool argument may only
# lower these):
# PDF_MAX_MB=25
# IMAGE_MAX_MB=8

# PDF OCR + image describe/OCR reuse the existing Workers AI binding (AI) and
# the VIDEO_VISION_MODEL id above. No second vision API is introduced; with no
# AI binding these features report "unavailable" instead of inventing output.
